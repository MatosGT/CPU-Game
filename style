:root {
    --bg-dark: #0d1117;
    --panel-bg: #161b22;
    --pcb-color: #131c24;
    --accent: #00f0ff;
    --success: #2ea043;
    --danger: #f85149;
    --gold: #eab308;
    --text-main: #e6edf3;
    --text-muted: #8b949e;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Segoe UI', system-ui, sans-serif;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

header {
    background: var(--panel-bg);
    padding: 1rem 2rem;
    border-bottom: 1px solid #30363d;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h1 {
    font-size: 1.4rem;
    color: var(--accent);
    letter-spacing: 1px;
}

.stats {
    display: flex;
    gap: 2rem;
    font-size: 1rem;
}

.workspace {
    display: grid;
    grid-template-columns: 280px 1fr 320px;
    gap: 1.5rem;
    padding: 1.5rem;
    flex: 1;
}

aside {
    background: var(--panel-bg);
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

h2 {
    font-size: 1.1rem;
    border-bottom: 1px solid #30363d;
    padding-bottom: 0.5rem;
}

.hint {
    font-size: 0.85rem;
    color: var(--text-muted);
}

/* Componentes Arrastáveis */
.parts-container {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
}

.part-item {
    background: #21262d;
    border: 1px solid #30363d;
    padding: 0.8rem;
    border-radius: 6px;
    cursor: grab;
    transition: transform 0.2s, border-color 0.2s;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.part-item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
}

.part-item.installed {
    opacity: 0.4;
    pointer-events: none;
    text-decoration: line-through;
}

.cpu-badge {
    display: inline-block;
    width: 24px;
    height: 24px;
    background: #8b949e;
    border: 2px solid var(--gold);
    position: relative;
    transition: transform 0.3s ease;
}

.cpu-badge::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 2px;
    width: 0;
    height: 0;
    border-left: 6px solid var(--gold);
    border-top: 6px solid transparent;
}

/* Motherboard */
.board-area {
    display: flex;
    justify-content: center;
    align-items: center;
}

.motherboard {
    width: 600px;
    height: 500px;
    background: var(--pcb-color);
    border: 3px solid #2b3a4a;
    border-radius: 12px;
    position: relative;
    box-shadow: 0 10px 30px rgba(0,0,0,0.6);
}

.slot {
    position: absolute;
    border: 2px dashed #48586a;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
}

.slot .label {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: bold;
    pointer-events: none;
    text-align: center;
}

.slot.drag-over {
    border-color: var(--accent);
    background: rgba(0, 240, 255, 0.1);
}

.slot.filled {
    border-style: solid;
    border-color: var(--success);
    background: rgba(46, 160, 67, 0.2);
}

/* Posições na Motherboard */
.eps-power { top: 20px; left: 40px; width: 110px; height: 40px; }
.cpu-socket { top: 120px; left: 150px; width: 120px; height: 120px; }
.ram-slots { top: 100px; left: 380px; width: 90px; height: 180px; }
.m2-slot { top: 275px; left: 320px; width: 160px; height: 32px; }
.pcie-slot { top: 340px; left: 120px; width: 340px; height: 35px; }

/* Detalhes do Socket */
.triangle-marker {
    position: absolute;
    bottom: 6px;
    left: 6px;
    width: 0;
    height: 0;
    border-left: 10px solid var(--gold);
    border-top: 10px solid transparent;
}

.retention-lever {
    position: absolute;
    right: -12px;
    top: 10px;
    width: 6px;
    height: 100px;
    background: #8b949e;
    border-radius: 3px;
    cursor: pointer;
}

.retention-lever.locked {
    background: var(--success);
    transform: translateY(8px);
}

/* Trilhas PCB */
.traces {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.traces path {
    fill: none;
    stroke: #263342;
    stroke-width: 3;
    transition: stroke 0.5s;
}

.traces path.active {
    stroke: var(--accent);
    filter: drop-shadow(0 0 4px var(--accent));
}

/* Botões e Feedback */
.controls {
    margin-top: auto;
    display: flex;
    gap: 0.5rem;
}

.btn {
    padding: 0.6rem;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    flex: 1;
}

.btn.secondary { background: #30363d; color: var(--text-main); }
.btn.danger { background: #da3633; color: white; }

.feedback {
    padding: 0.9rem;
    border-radius: 6px;
    font-size: 0.9rem;
    line-height: 1.4;
}

.feedback.info { background: rgba(0, 240, 255, 0.1); border-left: 4px solid var(--accent); }
.feedback.success { background: rgba(46, 160, 67, 0.15); border-left: 4px solid var(--success); }
.feedback.error { background: rgba(248, 81, 73, 0.15); border-left: 4px solid var(--danger); }

.bus-info ul {
    list-style: none;
    margin-top: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.85rem;
}

/* Modal */
.modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.8);
    display: flex;
    justify-content: center;
    align-items: center;
}

.modal.hidden { display: none; }

.modal-content {
    background: var(--panel-bg);
    padding: 2rem;
    border-radius: 10px;
    border: 1px solid var(--accent);
    max-width: 450px;
    width: 90%;
}

.quiz-options {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1rem;
}

.quiz-options button {
    padding: 0.8rem;
    background: #21262d;
    color: white;
    border: 1px solid #30363d;
    border-radius: 6px;
    cursor: pointer;
    text-align: left;
}

.quiz-options button:hover { border-color: var(--accent); }
